digraph classes {
graph [rankdir=TB, splines=true, nodesep=0.35, ranksep=0.45, fontname="Helvetica"];
node [shape=plain, fontname="Helvetica", fontsize=10];
edge [fontname="Helvetica", fontsize=8, color="#2B1B12", fontcolor="#5A4E46"];
"Coletor" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#2B1B12"><TR><TD BGCOLOR="#E9DCC8" ALIGN="CENTER"><B>Coletor</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T">- sessao: Session<BR ALIGN="LEFT"/>- robots: RobotFileParser<BR ALIGN="LEFT"/>- requisicoes: int<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T">+ obter(caminho): str<BR ALIGN="LEFT"/>+ coletar(max_paginas): dict<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"Ontologia" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#2B1B12"><TR><TD BGCOLOR="#E9DCC8" ALIGN="CENTER"><B>Ontologia</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T">+ categorias: dict<BR ALIGN="LEFT"/>+ habilidades: dict[str, Habilidade]<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T">+ ids(): list<BR ALIGN="LEFT"/>+ sinonimos(): dict<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"Habilidade" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#2B1B12"><TR><TD BGCOLOR="#E9DCC8" ALIGN="CENTER"><FONT POINT-SIZE="9">«dataclass»</FONT><BR/><B>Habilidade</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T">+ id: str<BR ALIGN="LEFT"/>+ nome: str<BR ALIGN="LEFT"/>+ categoria: str<BR ALIGN="LEFT"/>+ aliases: list<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"Normalizador" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#2B1B12"><TR><TD BGCOLOR="#E9DCC8" ALIGN="CENTER"><B>Normalizador</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T">- limiar: float = 0,87<BR ALIGN="LEFT"/>- tamanho_minimo_fuzzy: int<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T">+ extrair(texto, modo): list[Ocorrencia]<BR ALIGN="LEFT"/>+ normalizar_termo(termo): tuple<BR ALIGN="LEFT"/>+ mascarar(texto, evidencias): str<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"Ocorrencia" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#2B1B12"><TR><TD BGCOLOR="#E9DCC8" ALIGN="CENTER"><FONT POINT-SIZE="9">«dataclass»</FONT><BR/><B>Ocorrencia</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T">+ termo_original: str<BR ALIGN="LEFT"/>+ skill_id: str<BR ALIGN="LEFT"/>+ camada: str<BR ALIGN="LEFT"/>+ escore: float<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"HeteroGrafo" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#2B1B12"><TR><TD BGCOLOR="#E9DCC8" ALIGN="CENTER"><B>HeteroGrafo</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T">+ nos: dict[tipo, atributos]<BR ALIGN="LEFT"/>+ arestas: dict[relação, índices]<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T">+ validar(): dict<BR ALIGN="LEFT"/>+ salvar(pasta)<BR ALIGN="LEFT"/>+ carregar(pasta): HeteroGrafo<BR ALIGN="LEFT"/>+ subgrafo(tipo, id): dict<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"SAGEHetero" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#2B1B12"><TR><TD BGCOLOR="#E9DCC8" ALIGN="CENTER"><B>SAGEHetero</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T">- params: dict[str, ndarray]<BR ALIGN="LEFT"/>- hp: Hiper<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T">+ forward(X, M): dict<BR ALIGN="LEFT"/>+ backward(G, cache): dict<BR ALIGN="LEFT"/>+ embeddings(X, M): dict<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"Hiper" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#2B1B12"><TR><TD BGCOLOR="#E9DCC8" ALIGN="CENTER"><FONT POINT-SIZE="9">«dataclass»</FONT><BR/><B>Hiper</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T">+ camadas: int = 2<BR ALIGN="LEFT"/>+ dim_oculta: int = 32<BR ALIGN="LEFT"/>+ dropout: float<BR ALIGN="LEFT"/>+ decodificador_hibrido: bool<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"Adam" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#2B1B12"><TR><TD BGCOLOR="#E9DCC8" ALIGN="CENTER"><B>Adam</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T">- lr: float<BR ALIGN="LEFT"/>- wd: float<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T">+ passo(params, grads)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"ResultadoTreino" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#2B1B12"><TR><TD BGCOLOR="#E9DCC8" ALIGN="CENTER"><FONT POINT-SIZE="9">«dataclass»</FONT><BR/><B>ResultadoTreino</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T">+ modelo: SAGEHetero<BR ALIGN="LEFT"/>+ melhor_epoca: int<BR ALIGN="LEFT"/>+ historico: list<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"Base" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#2B1B12"><TR><TD BGCOLOR="#E9DCC8" ALIGN="CENTER"><FONT POINT-SIZE="9">«motor de recomendação»</FONT><BR/><B>Base</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T">+ disciplinas: list<BR ALIGN="LEFT"/>+ vagas: list<BR ALIGN="LEFT"/>+ afinidade: dict[modelo, matriz]<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T">+ trilha(cursadas, perfil, k, modelo): dict<BR ALIGN="LEFT"/>+ diagnostico(perfil): dict<BR ALIGN="LEFT"/>+ apoio_estrutural(habilidade): dict<BR ALIGN="LEFT"/>+ afinidade_disciplinas(habilidades): dict<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"API" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#2B1B12"><TR><TD BGCOLOR="#E9DCC8" ALIGN="CENTER"><FONT POINT-SIZE="9">«FastAPI»</FONT><BR/><B>API</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T">+ GET /api/interface<BR ALIGN="LEFT"/>+ POST /api/trilha<BR ALIGN="LEFT"/>+ GET /api/afinidade<BR ALIGN="LEFT"/>+ GET /api/diagnostico[.csv]<BR ALIGN="LEFT"/>+ GET /api/normalizar<BR ALIGN="LEFT"/>+ GET /api/normalizacao/auditoria<BR ALIGN="LEFT"/>+ GET /api/grafo/subgrafo<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"TrilhaEntrada" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#2B1B12"><TR><TD BGCOLOR="#E9DCC8" ALIGN="CENTER"><FONT POINT-SIZE="9">«Pydantic»</FONT><BR/><B>TrilhaEntrada</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T">+ cursadas: list[str]<BR ALIGN="LEFT"/>+ perfil: str<BR ALIGN="LEFT"/>+ k: int = 5<BR ALIGN="LEFT"/>+ modelo: str<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"RastreadorEnergia" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#2B1B12"><TR><TD BGCOLOR="#E9DCC8" ALIGN="CENTER"><B>RastreadorEnergia</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T">- etapa: str<BR ALIGN="LEFT"/>- p_nucleo: float<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T">+ __enter__()<BR ALIGN="LEFT"/>+ __exit__()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"Medicao" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#2B1B12"><TR><TD BGCOLOR="#E9DCC8" ALIGN="CENTER"><FONT POINT-SIZE="9">«dataclass»</FONT><BR/><B>Medicao</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T">+ duracao_s: float<BR ALIGN="LEFT"/>+ energia_kwh: float<BR ALIGN="LEFT"/>+ co2_g: float<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"Ontologia" -> "Habilidade" [arrowtail="diamond" dir="back" arrowhead="none", label="1..*"];
"Normalizador" -> "Ontologia" [arrowhead="vee", label="usa"];
"Normalizador" -> "Ocorrencia" [style="dashed" arrowhead="vee", label="produz"];
"Coletor" -> "Normalizador" [style="dashed" arrowhead="vee", label="vagas"];
"HeteroGrafo" -> "Normalizador" [style="dashed" arrowhead="vee", label="arestas ensina/exige"];
"SAGEHetero" -> "HeteroGrafo" [style="dashed" arrowhead="vee", label="treina sobre"];
"SAGEHetero" -> "Hiper" [arrowhead="vee", label=""];
"Adam" -> "SAGEHetero" [style="dashed" arrowhead="vee", label="otimiza"];
"ResultadoTreino" -> "SAGEHetero" [arrowhead="vee", label=""];
"Base" -> "SAGEHetero" [style="dashed" arrowhead="vee", label="afinidades"];
"Base" -> "Ontologia" [arrowhead="vee", label=""];
"API" -> "Base" [arrowhead="vee", label="consulta"];
"API" -> "HeteroGrafo" [arrowhead="vee", label="subgrafo"];
"API" -> "TrilhaEntrada" [style="dashed" arrowhead="vee", label="recebe"];
"API" -> "Normalizador" [arrowhead="vee", label="teste de termo"];
"RastreadorEnergia" -> "Medicao" [style="dashed" arrowhead="vee", label="registra"];
{rank=same; "Coletor"; "Ontologia"; "RastreadorEnergia";}
{rank=same; "Base"; "TrilhaEntrada";}
}